# ─── Database ──────────────────────────────────────────────────────────
DATABASE_URL=postgres://postgres:password@localhost:5432/tenkibench

# ─── Public-facing ─────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://bench.tenki.no
NEXT_PUBLIC_SITE_NAME=TenkiBench

# ─── Tenki SSO — påkrevd for /admin ───────────────────────────────────
# Sesjon-cookies (tenki_session, tenki_refresh) settes av tenki.no på
# Domain=.tenki.no og leses av bench. JWT verifiseres lokalt; refresh
# går mot auth.tenki.no.
SUPABASE_JWT_SECRET=                     # kopier fra /opt/tenki/env/supabase.env på hoved-VPS
NEXT_PUBLIC_SUPABASE_ANON_KEY=           # samme sted, brukes for refresh
TENKI_AUTH_BASE_URL=https://auth.tenki.no
TENKI_LOGIN_URL=https://auth.tenki.no/admin/login

# ─── Tenki SSO som OIDC-klient — VALGFRITT ───────────────────────────
# Hvis disse er satt bytter middleware til OIDC Authorization Code + PKCE
# i stedet for cookie-shared SSO. Cookie-flyten fungerer fortsatt parallelt
# (samme tenki_session-cookie skrives av callback-routen).
#
# Registrer bench-klienten på https://tenki.no/admin/sso. redirect_uri må
# matche TENKI_OIDC_REDIRECT_URI EKSAKT (også trailing slash / case).
TENKI_OIDC_CLIENT_ID=                    # utstedes ved registrering på tenki.no/admin/sso
TENKI_OIDC_CLIENT_SECRET=                # utstedes én gang — aldri logg eller commit
TENKI_OIDC_REDIRECT_URI=https://bench.tenki.no/api/auth/callback
TENKI_OIDC_AUTHORIZE_URL=https://auth.tenki.no/oauth/authorize
TENKI_OIDC_TOKEN_URL=https://auth.tenki.no/oauth/token
TENKI_OIDC_JWKS_URL=https://auth.tenki.no/oauth/.well-known/jwks.json   # fremtidig, for RS256-migrering

# ─── Lokal LLM (Mac Mini) — påkrevd ──────────────────────────────────
LOCAL_LLM_BASE_URL=https://mlx.tenki.no/v1
LOCAL_LLM_API_KEY=

# ─── Cron auth — påkrevd ─────────────────────────────────────────────
# Generer med: openssl rand -hex 32
CRON_TOKEN=

# ─── Judge-modell ─────────────────────────────────────────────────────
JUDGE_MODEL=gemma-3-4b-local
JUDGE_PROVIDER=local

# ─── Eksterne LLM-leverandører — VALGFRITT ───────────────────────────
MAMMOUTH_API_KEY=
MAMMOUTH_BASE_URL=https://api.mammouth.ai/v1
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# ─── Eksterne benchmark-data — VALGFRITT ─────────────────────────────
# Artificial Analysis API for å hente MMLU-Pro, GPQA, HumanEval osv.
# Gratis tier: 1000 req/døgn. Hent nøkkel på artificialanalysis.ai
ARTIFICIAL_ANALYSIS_API_KEY=
