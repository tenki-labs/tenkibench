# ─── Database ──────────────────────────────────────────────────────────
DATABASE_URL=postgres://postgres:password@localhost:5432/tenkibench

# ─── Public-facing ─────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://bench.tenki.no
NEXT_PUBLIC_SITE_NAME=TenkiBench

# ─── Lokal LLM (Mac Mini, gratis å kjøre) — påkrevd ───────────────────
# Bench v0.1 starter med kun denne modellen aktiv (gemma-3-4b-local).
LOCAL_LLM_BASE_URL=https://mlx.tenki.no/v1
LOCAL_LLM_API_KEY=

# ─── Admin + cron auth — påkrevd ──────────────────────────────────────
# Generer med: openssl rand -hex 32
ADMIN_TOKEN=
CRON_TOKEN=

# ─── Judge-modell ─────────────────────────────────────────────────────
# Brukes for llm_judge-eval. Default: lokal Gemma. Bytt til en sterkere
# modell når du har eksterne nøkler (f.eks. claude-opus-4-7 via Mammouth).
JUDGE_MODEL=gemma-3-4b-local
JUDGE_PROVIDER=local

# ─── Eksterne LLM-leverandører — VALGFRITT ────────────────────────────
# Sett kun når du vil aktivere modeller fra disse. Uten nøkkel kan modellen
# legges til, men kjøring vil feile med tydelig feilmelding.
#
# Mammouth.ai = gateway for GPT, Claude, Gemini, Mistral, DeepSeek, Grok, ...
# Én nøkkel gir tilgang til ~10 modeller. Anbefalt når du er klar.
MAMMOUTH_API_KEY=
MAMMOUTH_BASE_URL=https://api.mammouth.ai/v1

# Direkte leverandør-nøkler (alternativ til Mammouth)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
