# Database
DATABASE_URL=postgres://postgres:password@localhost:5432/tenkibench

# Public
NEXT_PUBLIC_SITE_URL=https://bench.tenki.no
NEXT_PUBLIC_SITE_NAME=TenkiBench

# Mammouth.ai — primary LLM gateway (OpenAI-compatible, gives us GPT-5, Claude 4.7, Gemini 3, Mistral, DeepSeek, Grok, ...)
MAMMOUTH_API_KEY=
MAMMOUTH_BASE_URL=https://api.mammouth.ai/v1

# Direct provider keys (optional — only needed if not going via Mammouth)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Local Mac Mini LLM (mlx_lm.server via tunnel)
LOCAL_LLM_BASE_URL=https://mlx.tenki.no/v1
LOCAL_LLM_API_KEY=

# Admin auth — random hex, used to gate /admin
ADMIN_TOKEN=

# Cron auth — random hex, required as Bearer on /api/cron/*
CRON_TOKEN=

# Judge model (used by llm-judge eval method) — defaults to a strong model
JUDGE_MODEL=claude-opus-4-7
JUDGE_PROVIDER=mammouth
